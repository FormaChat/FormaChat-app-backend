
# ── SERVER ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── DATABASE (shared mongoose connection) ─────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── REDIS ─────────────────────────────────────────────────────
# Used by both auth (ioredis) and chat (node-redis) — same server
REDIS_URL=redis://:<password>@<host>:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ── RABBITMQ ──────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=auth.exchange
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=5000
RABBITMQ_MAX_RETRY_DELAY=300000
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_HEARTBEAT=60

# RabbitMQ queue names (email service)
QUEUE_AUTH_EMAILS=auth.emails
QUEUE_PAYMENT_EMAILS=payment.emails
QUEUE_NOTIFICATION_EMAILS=notification.emails
QUEUE_BUSINESS_EMAILS=business.emails
QUEUE_RETRY=email.retry
QUEUE_DLQ=email.dlq

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=<minimum-32-character-secret>
JWT_REFRESH_SECRET=<minimum-32-character-secret>
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=formachat-auth-service

# ── INTERNAL SERVICE SECURITY ─────────────────────────────────
# Shared secret used in x-service-token header between services
INTERNAL_SERVICE_SECRET=<minimum-32-character-secret>

# ── CROSS-SERVICE URLS ────────────────────────────────────────
# In monolith mode all services live on the same PORT — point both here
BUSINESS_SERVICE_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3000

# ── PINECONE ──────────────────────────────────────────────────
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=formachat-businesses

# ── LLM / GROQ ────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=500

# ── EMAIL / RESEND ────────────────────────────────────────────
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM_EMAIL=noreply@formachat.com

# ── ADMIN ─────────────────────────────────────────────────────
ADMIN_API_KEY=<minimum-16-character-key>

# ── CHAT SESSION LIMITS ───────────────────────────────────────
DAILY_SESSION_LIMIT=100
SESSION_LIMIT_WINDOW=86400
MESSAGE_RETENTION_DAYS=7

# ── SECURITY / RATE LIMITING ──────────────────────────────────
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_ATTEMPTS=100
OTP_RATE_LIMIT_MAX=5
BCRYPT_ROUNDS=12
IDEMPOTENCY_TTL=3600
IDEMPOTENCY_KEY_TTL=3600

# ── OTP ───────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# ── LOGGING ───────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE_PATH=./logs/formachat.log
ENABLE_FILE_LOGGING=false
LOG_EMAIL_CONTENT=false

# ── MISC ──────────────────────────────────────────────────────
CORS_CREDENTIALS=true
SECURITY_HSTS_MAX_AGE=31536000
HEALTH_CHECK_INTERVAL=30000
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=128
MIN_NAME_LENGTH=2
MAX_NAME_LENGTH=50
