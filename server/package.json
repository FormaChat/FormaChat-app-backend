{
  "name": "formachat-server",
  "version": "1.0.0",
  "description": "FormaChat monolith backend server",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && copyfiles -u 1 \"src/**/*.hbs\" dist",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts --ext ts,js",
    "lint": "tsc --noEmit",
    "email:preview": "tsx scripts/send-template-previews.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^3.0.0",
    "amqplib": "^0.10.4",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "express": "^4.19.2",
    "file-type": "^16.5.4",
    "groq-sdk": "^0.7.0",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "pdf-parse": "^1.1.1",
    "redis": "^4.7.0",
    "resend": "^4.0.0",
    "tesseract.js": "^5.1.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/handlebars": "^4.1.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.4",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
