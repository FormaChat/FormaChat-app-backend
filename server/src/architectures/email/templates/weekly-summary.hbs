<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{businessName}} - Weekly Report</title>
</head>
<body style="margin:0; padding:0; background:#ffffff; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <div style="max-width:480px; margin:0 auto; padding:0 24px 40px;">

    <img src="{{emailBannerUrl}}" alt="FormaChat" width="480" style="width:100%; max-width:480px; display:block; margin:32px auto 28px; border:0;">

    <p style="font-size:15px; line-height:1.65; color:#333333; margin:0 0 4px;">Hi {{firstName}},</p>
    <p style="font-size:15px; line-height:1.65; color:#333333; margin:0 0 4px;">Here's how <strong>{{businessName}}</strong>'s AI agent performed this week ({{weekRange}}):</p>

    <p style="font-size:15px; line-height:1.9; color:#333333; margin:24px 0 24px;">
      Conversations: <strong>{{totalConversations}}</strong><br>
      New leads: <strong>{{newLeads}}</strong><br>
      Messages sent: <strong>{{totalMessages}}</strong><br>
      Avg. messages per chat: <strong>{{avgMessagesPerSession}}</strong>
    </p>

    {{#if topQuestion}}
    <p style="font-size:15px; line-height:1.65; color:#333333; margin:0 0 4px;"><strong>Most asked this week:</strong></p>
    <p style="font-size:15px; line-height:1.65; color:#333333; margin:0 0 24px; font-style:italic;">"{{topQuestion}}"</p>
    {{/if}}

    {{#if newLeadsDetails}}
    <p style="font-size:15px; line-height:1.65; color:#333333; margin:0 0 8px;"><strong>New leads this week:</strong></p>
    <p style="font-size:15px; line-height:1.8; color:#333333; margin:0 0 24px;">
      {{#each newLeadsDetails}}
      {{this.name}}{{#if this.email}} - <a href="mailto:{{this.email}}" style="color:#636b2f;">{{this.email}}</a>{{/if}}{{#if this.phone}} - {{this.phone}}{{/if}}<br>
      {{/each}}
    </p>
    {{/if}}

    <p style="text-align:center; margin:0 0 8px;">
      <a href="https://formachat.com/#/dashboard/analytics/{{businessId}}" style="display:inline-block; padding:13px 30px; background:#636b2f; color:#ffffff; text-decoration:none; border-radius:6px; font-weight:600; font-size:15px;">View Full Analytics</a>
    </p>

    <hr style="border:none; border-top:1px solid #636b2f; opacity:0.25; margin:32px 0 20px;">

    <p style="font-size:12px; line-height:1.6; color:#999999; margin:0;">
      &copy; {{currentYear}} FormaChat. All rights reserved.<br>
      You're receiving this because you have a FormaChat business profile. <a href="mailto:support@formachat.com" style="color:#636b2f;">Unsubscribe</a>
    </p>

  </div>
</body>
</html>
