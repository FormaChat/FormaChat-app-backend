<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.6;
      color: #1a1a1a;
      margin: 0;
      padding: 0;
      background-color: #f5f5f5;
    }
    .container {
      max-width: 600px;
      margin: 40px auto;
      background: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      border: 1px solid #eeeeee;
    }
    .header {
      background: linear-gradient(135deg, #636b2f 0%, #4f5625 100%);
      padding: 30px;
      text-align: center;
      color: #ffffff;
    }
    .header h1 {
      margin: 0 0 6px 0;
      font-size: 24px;
      font-weight: 800;
    }
    .header p {
      margin: 0;
      font-size: 13px;
      opacity: 0.8;
    }
    .content {
      padding: 36px 30px 28px;
    }
    .cta-section {
      text-align: center;
      margin: 32px 0 8px;
    }
    .btn-primary {
      display: inline-block;
      padding: 15px 36px;
      background-color: #636b2f;
      color: #ffffff;
      text-decoration: none;
      border-radius: 6px;
      font-weight: 700;
      font-size: 16px;
      box-shadow: 0 4px 12px rgba(99,107,47,0.3);
    }
    .timer-bar {
      background: #f5f5f5;
      border-radius: 6px;
      padding: 10px 16px;
      text-align: center;
      font-size: 13px;
      color: #555;
      margin: 24px 0 0;
    }
    .timer-bar strong {
      color: #636b2f;
    }
    .security-note {
      background: #fff8f0;
      border-left: 3px solid #e8a23a;
      border-radius: 4px;
      padding: 12px 16px;
      font-size: 13px;
      color: #7a4f1a;
      margin-top: 24px;
    }
    .fallback-link {
      word-break: break-all;
      font-size: 12px;
      color: #888;
      margin-top: 20px;
    }
    .footer {
      text-align: center;
      padding: 20px 30px;
      background-color: #f9fafb;
      color: #888888;
      font-size: 12px;
      border-top: 1px solid #eeeeee;
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#f5f5f5;">

  <div class="container" style="background-color:#ffffff;">

    <div class="header" style="background:linear-gradient(135deg,#636b2f 0%,#4f5625 100%); padding:30px; text-align:center; color:#ffffff;">
      <h1 style="margin:0 0 6px 0; font-size:24px; font-weight:800;">FormaChat</h1>
      <p style="margin:0; font-size:13px; opacity:0.8;">Your sign-in link</p>
    </div>

    <div class="content" style="padding:36px 30px 28px;">

      <p style="font-size:16px; margin:0 0 6px 0; color:#1a1a1a;">Hi there,</p>
      <p style="font-size:15px; margin:0 0 4px 0; color:#444;">
        Click the button below to sign in to FormaChat. No password needed.
      </p>

      <div class="cta-section" style="text-align:center; margin:32px 0 8px;">
        <a href="{{magicLinkUrl}}" class="btn-primary"
           style="display:inline-block; padding:15px 36px; background-color:#636b2f; color:#ffffff; text-decoration:none; border-radius:6px; font-weight:700; font-size:16px; box-shadow:0 4px 12px rgba(99,107,47,0.3);">
          Sign In to FormaChat →
        </a>
      </div>

      <div class="timer-bar" style="background:#f5f5f5; border-radius:6px; padding:10px 16px; text-align:center; font-size:13px; color:#555; margin:24px 0 0;">
        ⏱ This link expires in <strong style="color:#636b2f;">10 minutes</strong> and can only be used once.
      </div>

      <div class="security-note" style="background:#fff8f0; border-left:3px solid #e8a23a; border-radius:4px; padding:12px 16px; font-size:13px; color:#7a4f1a; margin-top:24px;">
        ⚠️ <strong>Security reminder:</strong> If you didn't request this link, ignore this email — your account is safe.
      </div>

      <p class="fallback-link" style="word-break:break-all; font-size:12px; color:#888; margin-top:20px;">
        Button not working? Copy and paste this link into your browser:<br>
        {{magicLinkUrl}}
      </p>

      <p style="margin-top:28px; font-size:15px; color:#1a1a1a;">The FormaChat Team</p>

    </div>

    <div class="footer" style="text-align:center; padding:20px 30px; background-color:#f9fafb; color:#888; font-size:12px; border-top:1px solid #eee;">
      <p style="margin:4px 0;">&copy; {{currentYear}} FormaChat. All rights reserved.</p>
      <p style="margin:4px 0; color:#aaa;">If you didn't request this link, no action is needed.</p>
    </div>

  </div>
</body>
</html>
